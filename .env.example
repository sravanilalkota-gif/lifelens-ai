# ------------------------------------------------------------------
# LifeLens AI — environment variables
# Copy this file to `.env` at the project root:  cp .env.example .env
# ------------------------------------------------------------------

# Port for the Express API (client dev server proxies /api here)
PORT=4000

# --- Gemini (optional!) -------------------------------------------------
# Leave GEMINI_API_KEY empty and LifeLens automatically runs in DEMO MODE
# with the built-in rule-based understanding engine + sample documents.
# Get a key at https://aistudio.google.com/apikey  (free tier is enough)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Demo user (no real auth in the MVP, by design) ---------------------
USER_NAME=Sravani
USER_COURSE=B.Tech CSE • 3rd Year

# --- Upload limits ------------------------------------------------------
MAX_UPLOAD_MB=6
